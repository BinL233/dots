# Ghostty Split Navigation with Cmd + Arrow Keys
keybind = super+left=goto_split:left
keybind = super+right=goto_split:right
keybind = super+up=goto_split:top
keybind = super+down=goto_split:bottom

theme = Catppuccin Macchiato

background-opacity = 0.93
background-blur = false

window-decoration = false
macos-option-as-alt = left
macos-titlebar-style = hidden
macos-window-shadow = false

window-padding-x = 8
window-padding-y = 8
window-decoration = auto
window-theme = auto

font-family = "JetBrains Mono NL Regular"
#
# adjust-cell-width = -10%
# font-thicken = false

keybind = ctrl+shift+up=scroll_page_lines:-10
keybind = ctrl+shift+down=scroll_page_lines:10

keybind = super+shift+I=new_split:right
keybind = chain=resize_split:right,500

keybind = global:cmd+shift+t=new_window
